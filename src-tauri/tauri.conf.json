{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hephaestus",
  "version": "0.2.0",
  "identifier": "com.hephaestus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hephaestus",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Design intelligence — palettes, trends, rules.",
    "longDescription": "Hephaestus is a design intelligence workspace: forge colour palettes from plain language, browse recombination-engine design directions, and get rule-based critiques from Cedalion. No AI — every answer comes from its own algorithms.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
